---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props { project: CollectionEntry<"projects">; index?: number; }
const { project, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL === "/" ? "/" : `${import.meta.env.BASE_URL}/`;
const href = `${base}projects/${project.id}`;
---
<article class:list={["card", index % 3 === 0 && "card--wide"]} data-category={project.data.category}>
  <a href={href}>
    <div class="visual">
      <Image src={project.data.cover} alt={project.data.description} widths={[480, 800, 1200, 1600]} sizes={index % 3 === 0 ? "(min-width: 800px) 65vw, 100vw" : "(min-width: 800px) 48vw, 100vw"} loading={index < 2 ? "eager" : "lazy"} />
      <span class="index">{String(index + 1).padStart(2, "0")}</span>
      <span class="view">View project ↗</span>
    </div>
    <div class="meta">
      <h2>{project.data.title}</h2>
      <p>{project.data.location}</p>
      <p>{project.data.year}</p>
    </div>
  </a>
</article>
<style>
  .card { min-width: 0; }
  .card--wide { grid-column: span 2; }
  a { text-decoration: none; }
  .visual { position: relative; overflow: hidden; background: #d5d5d0; aspect-ratio: 4 / 5; }
  .card--wide .visual { aspect-ratio: 16 / 9; }
  .visual :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.7); transition: transform .8s var(--ease), filter .5s ease; }
  a:hover .visual :global(img) { transform: scale(1.025); filter: saturate(1); }
  .index, .view { position: absolute; top: 1rem; padding: .45rem .65rem; background: var(--surface); font-family: var(--font-meta); font-size: .64rem; letter-spacing: .07em; text-transform: uppercase; }
  .index { left: 1rem; }
  .view { right: 1rem; opacity: 0; transform: translateY(.5rem); transition: .3s var(--ease); }
  a:hover .view { opacity: 1; transform: none; }
  .meta { display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; gap: 2rem; padding-top: .85rem; }
  h2, p { margin: 0; }
  h2 { font-size: clamp(1.35rem, 2.2vw, 2.2rem); font-weight: 600; letter-spacing: -.04em; line-height: 1; }
  p { color: var(--muted); font-family: var(--font-meta); font-size: .66rem; letter-spacing: .04em; text-transform: uppercase; }
  @media (max-width: 700px) { .card--wide { grid-column: auto; } .card--wide .visual, .visual { aspect-ratio: 4 / 5; } .meta { grid-template-columns: 1fr auto; gap: .5rem; } .meta p:first-of-type { grid-column: 1 / -1; grid-row: 2; } }
</style>
