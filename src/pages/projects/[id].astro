---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectGallery from "@/components/projects/ProjectGallery.astro";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project: CollectionEntry<"projects">) => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<"projects">; }
const { project } = Astro.props;
const { Content } = await render(project);
const all: CollectionEntry<"projects">[] = await getCollection("projects");
all.sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => a.data.order - b.data.order);
const currentIndex = all.findIndex((item: CollectionEntry<"projects">) => item.id === project.id);
const next = all[(currentIndex + 1) % all.length];
const base = import.meta.env.BASE_URL === "/" ? "/" : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title={`${project.data.title} — Junge Architekt`} description={project.data.description}>
  <article>
    <header class="project-head shell">
      <p class="eyebrow">{project.data.category} · {project.data.year}</p>
      <h1 class="display">{project.data.title}</h1>
      <p class="location">{project.data.location}</p>
    </header>
    <div class="cover">
      <Image src={project.data.cover} alt={project.data.description} widths={[800, 1280, 1920, 2400]} sizes="100vw" loading="eager" />
    </div>
    <section class="project-copy shell section">
      <aside>
        <dl>
          <div><dt>Year</dt><dd>{project.data.year}</dd></div>
          <div><dt>Status</dt><dd>{project.data.status}</dd></div>
          <div><dt>Scope</dt><dd>{project.data.scope.join(", ")}</dd></div>
          {project.data.architect && <div><dt>Architect</dt><dd>{project.data.architect}</dd></div>}
          {project.data.client && <div><dt>Client</dt><dd>{project.data.client}</dd></div>}
        </dl>
      </aside>
      <div class="narrative"><Content /></div>
    </section>
    <ProjectGallery images={project.data.gallery} />
    <a class="next shell" href={`${base}projects/${next.id}`}>
      <span class="eyebrow">Next project</span><strong>{next.data.title}</strong><span>↗</span>
    </a>
  </article>
</BaseLayout>
<style>
  .project-head { padding-block: clamp(4rem, 9vw, 8rem) 2rem; }
  .project-head .display { max-width: 12ch; }
  .location { margin: 2rem 0 0; color: var(--muted); font-family: var(--font-meta); text-transform: uppercase; letter-spacing: .08em; font-size: .66rem; }
  .cover { width: 100%; height: min(78vh, 60rem); background: #d5d5d0; overflow: hidden; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .project-copy { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1rem; }
  aside { grid-column: 1 / 5; }
  dl { margin: 0; border-top: 1px solid var(--line); }
  dl div { display: grid; grid-template-columns: 1fr 2fr; padding: .8rem 0; border-bottom: 1px solid var(--line); font-size: .78rem; line-height: 1.4; }
  dt { color: var(--muted); font-family: var(--font-meta); font-size: .64rem; letter-spacing: .04em; text-transform: uppercase; }
  dd { margin: 0; }
  .narrative { grid-column: 6 / -1; max-width: 44rem; font-size: clamp(1.15rem, 1.7vw, 1.55rem); letter-spacing: -.022em; line-height: 1.48; }
  .narrative :global(p:first-child) { margin-top: 0; }
  .next { display: grid; grid-template-columns: 1fr auto; align-items: end; padding-block: var(--section); text-decoration: none; border-top: 1px solid var(--line); }
  .next .eyebrow { grid-column: 1 / -1; }
  .next strong { font-family: var(--font-display); font-size: clamp(3rem, 8vw, 8rem); line-height: .92; letter-spacing: -.06em; font-weight: 600; }
  .next > span:last-child { font-size: 3rem; }
  @media (max-width: 700px) { .cover { height: 65vh; } .project-copy { display: block; } aside { margin-bottom: 3rem; } }
</style>
