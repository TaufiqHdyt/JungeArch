---
const base = import.meta.env.BASE_URL === "/" ? "/" : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname;
const links = [
  { href: `${base}projects`, label: "Projects" },
  { href: `${base}studio`, label: "Studio" },
  { href: `${base}contact`, label: "Contact" },
];
---
<header class="header shell">
  <a class="brand" href={base} aria-label="Junge Architekt home">JUNGE<span>®</span></a>
  <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
    <span class="menu-label">Menu</span>
    <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
  </button>
  <nav id="site-nav" aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={path.includes(link.href.replace(base, "")) ? "page" : undefined}>{link.label}</a>)}
  </nav>
</header>
<script>
  function setupMenu() {
    const button = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const nav = document.querySelector<HTMLElement>("#site-nav");
    if (!button || !nav || button.dataset.bound === "true") return;

    button.dataset.bound = "true";
    const label = button.querySelector<HTMLElement>(".menu-label");

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      nav.toggleAttribute("data-open", open);
      document.documentElement.toggleAttribute("data-menu-open", open);
      if (label) label.textContent = open ? "Close" : "Menu";
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });
    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }

  setupMenu();
  document.addEventListener("astro:page-load", setupMenu);
</script>
<style>
  .header { position: relative; z-index: 30; display: flex; align-items: center; justify-content: space-between; height: 6.5rem; border-bottom: 1px solid var(--line); }
  .brand { font-family: var(--font-display); font-weight: 800; letter-spacing: -.055em; line-height: 1; text-decoration: none; font-size: 1.5rem; }
  .brand span { color: var(--muted); font-size: .55rem; vertical-align: top; margin-left: .15rem; }
  nav { display: flex; gap: clamp(1.5rem, 4vw, 4rem); }
  nav a { position: relative; font-family: var(--font-meta); font-size: .7rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  nav a::after { content: ""; position: absolute; inset: auto 0 -.5rem; height: 2px; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
  nav a:hover::after, nav a[aria-current="page"]::after { transform: scaleX(1); }
  .menu { display: none; align-items: center; gap: .7rem; padding: .7rem 0 .7rem .7rem; border: 0; color: var(--ink); background-color: transparent; font-family: var(--font-meta); text-transform: uppercase; font-size: .7rem; letter-spacing: .08em; cursor: pointer; }
  .menu-icon { display: grid; width: 1.25rem; gap: .3rem; }
  .menu-icon i { display: block; height: 1px; background: currentColor; transition: transform .25s var(--ease); }
  .menu[aria-expanded="true"] .menu-icon i:first-child { transform: translateY(.2rem) rotate(45deg); }
  .menu[aria-expanded="true"] .menu-icon i:last-child { transform: translateY(-.2rem) rotate(-45deg); }
  @media (max-width: 640px) {
    .header { height: 5rem; }
    .menu { display: flex; }
    nav { display: none; position: fixed; z-index: 29; top: 5rem; left: 0; right: 0; bottom: 0; flex-direction: column; justify-content: center; gap: 0; padding: 2rem var(--page); background: var(--ink); color: var(--surface); }
    nav[data-open] { display: flex; }
    nav a { padding: 1rem 0; font-size: clamp(2rem, 11vw, 4rem); line-height: 1; letter-spacing: -.04em; border-bottom: 1px solid rgba(255,255,255,.2); }
  }
</style>
