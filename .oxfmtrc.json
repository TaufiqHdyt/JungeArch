{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": ["assets/**", "dist/**", "node_modules/**", "src/assets/**"]
}
